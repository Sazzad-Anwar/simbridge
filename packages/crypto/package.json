{
  "name": "@simbridge/crypto",
  "version": "0.1.0",
  "private": true,
  "description": "SIMBridge end-to-end encryption (X25519 + XSalsa20-Poly1305) — runs on Node.js and React Native",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@simbridge/shared": "workspace:*",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
