# SIMBridge API configuration (apps/api/.env)
PORT=3000
HOST=0.0.0.0

# Local MongoDB — no cloud required
MONGO_URI=mongodb://127.0.0.1:27017/simbridge

# Auth — CHANGE THIS IN PRODUCTION
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Data retention
MESSAGE_TTL_DAYS=7
AUDIT_TTL_DAYS=30
PAIRING_CODE_TTL_MINUTES=2

# Rate limiting (per device+IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240

# CORS
CORS_ORIGIN=*

LOG_LEVEL=info
