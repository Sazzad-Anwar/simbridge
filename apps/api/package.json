{
  "name": "@simbridge/api",
  "version": "0.1.0",
  "private": true,
  "description": "SIMBridge backend — Elysia.js REST API + Socket.IO real-time messaging + MongoDB",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.3.0",
    "@elysiajs/swagger": "^1.3.0",
    "@simbridge/crypto": "workspace:*",
    "@simbridge/shared": "workspace:*",
    "@sinclair/typebox": "~0.34.52",
    "elysia": "^1.3.0",
    "jose": "^6.2.12",
    "mongoose": "^8.16.0",
    "socket.io": "^4.8.1"
  },
  "optionalDependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "ioredis": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
